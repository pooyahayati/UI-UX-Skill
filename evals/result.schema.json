{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI/UX Skill Behavioral Eval Result",
  "description": "Shape contract only. validate_eval_result.py also enforces current manifest identities, unique cases/invariants and the verdict-consistency rules in evals/README.md. A coherent failure is recordable, not release acceptance. Duplicate JSON fields are rejected by the CLI.",
  "type": "object",
  "required": [
    "skillVersion",
    "host",
    "model",
    "date",
    "cases"
  ],
  "properties": {
    "skillVersion": {
      "type": "string"
    },
    "host": {
      "type": "string",
      "pattern": "\\S"
    },
    "model": {
      "type": "string",
      "pattern": "\\S"
    },
    "date": {
      "type": "string",
      "pattern": "\\S"
    },
    "fixtureCommit": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "triggerMode",
          "result",
          "invariants"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "triggerMode": {
            "enum": [
              "explicit",
              "implicit"
            ]
          },
          "result": {
            "description": "pass requires all required invariants to pass; any invariant fail requires case fail; not-testable requires all untested. partial permits partial or mixed passed/untested requirements, never a failure or all untested. Conservative fail, or partial with all invariants passed, requires nonblank case notes.",
            "enum": [
              "pass",
              "partial",
              "fail",
              "not-testable"
            ]
          },
          "notes": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "text",
                "result"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "result": {
                  "enum": [
                    "pass",
                    "partial",
                    "fail",
                    "not-testable"
                  ]
                },
                "evidence": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
