{
  "schema_version": 1,
  "policy": {
    "local_rules_only": true,
    "load_after_product_route": true,
    "require_scope_based_loading": true,
    "product_pack_specializes_shared_rules": true,
    "shared_rules_define_cross_product_contracts": true,
    "product_pack_must_not_weaken_accessibility_security_or_data_integrity": true
  },
  "modules": [
    {
      "id": "navigation-wayfinding",
      "reference": "references/shared/navigation-wayfinding.md",
      "triggers": [
        "navigation",
