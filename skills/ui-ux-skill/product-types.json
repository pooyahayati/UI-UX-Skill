{
  "schema_version": 1,
  "policy": {
    "classification_required": true,
    "allow_multiple_routes": true,
    "require_primary_route": true,
    "product_rules_are_mandatory": true,
    "fallback_route": "generic-product-ui"
  },
  "products": [
    {
      "id": "dashboard",
      "label": "Dashboard / Operational Dashboard",
      "triggers": [
        "dashboard",
        "analytics dashboard",
        "admin dashboard",
        "CRM dashboard",
        "operations dashboard",
        "monitoring dashboard",
        "data-heavy operational overview"
      ],
      "required_references": [
        "references/products/dashboard.md"
      ],
      "local_references": {
        "executive": "references/products/dashboard/executive.md",
        "analytical": "references/products/dashboard/analytical.md",
        "operational": "references/products/dashboard/operational.md",
        "monitoring_noc": "references/products/dashboard/monitoring-noc.md",
        "crm_pipeline": "references/products/dashboard/crm-pipeline.md",
        "admin_management": "references/products/dashboard/admin-management.md"
      }
    },
    {
      "id": "web-application",
      "label": "Web Application",
      "triggers": [
        "web application",
        "web app",
        "SaaS application",
        "browser-based product",
        "multi-page or routed application UI",
        "authenticated application"
      ],
      "exclusions": [
        "marketing-only website",
        "landing-page-only work"
      ],
      "required_references": [
        "references/products/web-application.md"
      ]
    },
    {
      "id": "mobile-application",
      "label": "Mobile Application",
      "triggers": [
        "mobile application",
        "mobile app",
        "iOS app",
        "Android app",
        "native app",
        "Flutter app",
        "React Native app",
        "hybrid mobile app"
      ],
      "required_references": [
        "references/products/mobile-application.md"
      ],
      "platform_references": {
        "ios": "references/products/mobile/ios.md",
        "android": "references/products/mobile/android.md",
        "cross_platform": "references/products/mobile/cross-platform.md"
      }
    },
    {
      "id": "wordpress-plugin",
      "label": "WordPress Plugin / Admin UI",
      "triggers": [
        "WordPress plugin",
        "WordPress plugin settings",
        "WordPress plugin admin page",
        "WordPress plugin configuration UI",
        "wp-admin plugin settings",
        "plugin onboarding/settings screen",
        "plugin diagnostics/status screen",
        "plugin tools/admin workflow"
      ],
      "required_references": [
        "references/products/wordpress-plugin.md"
      ],
      "local_references": {
        "settings": "references/products/wordpress/settings.md",
        "onboarding_integrations": "references/products/wordpress/onboarding-integrations.md",
        "diagnostics_operations": "references/products/wordpress/diagnostics-operations.md",
        "multisite_admin": "references/products/wordpress/multisite-admin.md"
      }
    },
    {
      "id": "website",
      "label": "Website / Public-Facing Website",
      "triggers": [
        "website",
        "company website",
        "corporate website",
        "business website",
        "service website",
        "marketing website",
        "content website",
        "blog",
        "publication website",
        "portfolio website",
        "personal brand website",
        "landing page",
        "public-facing informational site",
        "SEO-driven website"
      ],
      "exclusions": [
        "authenticated web application whose primary purpose is doing work inside an app",
        "mobile application",
        "WordPress plugin/admin UI"
      ],
      "required_references": [
        "references/products/website.md"
      ]
    },
    {
      "id": "generic-product-ui",
      "label": "Generic Product UI",
      "triggers": [
        "product UI that does not yet match a registered product type"
      ],
      "required_references": [
        "references/product-routing.md"
      ],
      "fallback_only": true
    }
  ]
}
